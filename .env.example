# Clave de API de DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=pon_tu_clave_aquí

# URL base de la API de DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modelo de chat: usa deepseek-v4-flash para máxima economía,
# o deepseek-v4-pro para tareas complejas que requieran más razonamiento.
# Ambos tienen contexto de 1M tokens.
DEEPSEEK_MODEL=deepseek-v4-flash

# Tokens máximos de respuesta (limita el gasto por consulta)
DEEPSEEK_MAX_TOKENS=1024

# Temperatura (0 = determinista, más barato y predecible)
DEEPSEEK_TEMPERATURE=0

# Carpeta de documentos a indexar (ruta relativa a knowledge-engine)
DOCS_DIR=../knowledge-vault

# Carpeta donde ChromaDB guarda la base de datos vectorial
CHROMA_DB_PATH=./chroma_db

# Modelo de embeddings local (BAAI/bge-m3 es multilingüe, potente y gratuito)
# DeepSeek no ofrece API de embeddings pública, así que usamos este modelo local.
EMBEDDING_MODEL=BAAI/bge-m3

# Tamaño de fragmentos (en caracteres). 1000 ≈ 250 palabras.
# Con 1M de contexto en DeepSeek, puedes aumentar esto si quieres.
CHUNK_SIZE=1000

# Superposición entre fragmentos
CHUNK_OVERLAP=200

# Número de resultados por defecto al buscar
N_RESULTS=8
