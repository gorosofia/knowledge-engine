# Clave de API de DeepSeek (la obtienes en https://platform.deepseek.com/)
DEEPSEEK_API_KEY=pon_tu_clave_aquí

# URL base de la API de DeepSeek (no cambiar a menos que uses un proxy)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modelo de chat de DeepSeek
DEEPSEEK_MODEL=deepseek-chat

# Carpeta de documentos a indexar (ruta relativa a knowledge-engine)
# "../knowledge-vault" apunta a la carpeta hermana donde está tu vault de Obsidian
DOCS_DIR=../knowledge-vault

# Carpeta donde ChromaDB guarda la base de datos vectorial
CHROMA_DB_PATH=./chroma_db

# Modelo de embeddings (BAAI/bge-m3 es multilingüe y muy potente)
EMBEDDING_MODEL=BAAI/bge-m3

# Tamaño de fragmentos (en caracteres). 1000 ≈ 250 palabras
CHUNK_SIZE=1000

# Superposición entre fragmentos (evita cortar ideas a la mitad)
CHUNK_OVERLAP=200

# Número de resultados por defecto al buscar
N_RESULTS=5
